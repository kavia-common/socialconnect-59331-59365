# Server configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Security
# IMPORTANT: Provide a strong random secret in real deployments.
JWT_SECRET=replace-with-a-strong-random-secret

# Database (MongoDB)
# MONGODB_URI example for Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=socialconnect

# Cloudinary (Media storage)
# Get your credentials from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS configuration
# Comma-separated list of allowed origins for REST and Socket
CORS_ORIGIN=http://localhost:3000
SOCKET_CORS_ORIGIN=http://localhost:3000
