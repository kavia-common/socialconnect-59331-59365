# API base URL for REST requests
# Example (local dev with backend on 3001): http://localhost:3001
REACT_APP_API_BASE_URL=http://localhost:3001

# Socket URL for real-time updates via Socket.IO
# Typically same as API base but can be different if proxied
REACT_APP_SOCKET_URL=http://localhost:3001

# Cloudinary unsigned upload preset name used by client uploads (if applicable)
# Create an unsigned preset in Cloudinary settings and place its name here
REACT_APP_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
